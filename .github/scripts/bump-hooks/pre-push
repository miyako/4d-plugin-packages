#!/bin/sh
set -eu

test "$#" -eq 2
test "$1" = origin
test "$(git rev-parse HEAD)" = "$BUMP_NEW_SHA"
test "$(git rev-parse "$BUMP_NEW_SHA^")" = "$BUMP_EXPECTED_SHA"
test "$BUMP_NEW_SHA" != "$BUMP_EXPECTED_SHA"
test -z "$(git status --porcelain)"

count=0
while read -r local_ref local_sha remote_ref remote_sha; do
    count=$((count + 1))
    if [ "$local_ref" != "$BUMP_NEW_SHA" ] ||
       [ "$remote_ref" != "$BUMP_EXPECTED_REF" ] ||
       [ "$remote_sha" != "$BUMP_EXPECTED_SHA" ] ||
       [ "$local_sha" != "$BUMP_NEW_SHA" ]; then
        echo "Bump rejected: advertised branch state differs from selected SHA/ref." >&2
        exit 1
    fi
done

# Git omits up-to-date refs from hook input; reject a same-result race too.
if [ "$count" -ne 1 ]; then
    echo "Bump rejected: expected exactly one advertised branch update." >&2
    exit 1
fi
